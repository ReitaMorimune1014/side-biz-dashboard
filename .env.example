NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ログイン用リンクの戻り先(秘密ではないが、サーバー専用)。ブラウザで開くURLと同じホストにする
SITE_URL=http://localhost:3000
# 注意: secret key / service_role key は、ここにも .env.local にも NEXT_PUBLIC_ を付けて置かない

# 公開デモの環境だけで設定する(README の「公開デモの作り方」)。サーバー専用なので NEXT_PUBLIC_ を付けない
# DEMO_MODE=true
# DEMO_EMAIL=
# DEMO_PASSWORD=

# 結合テストで、ローカルの DB に直接つなぐときの接続先(省略時はローカルの既定値。ローカル以外は拒否する)
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
